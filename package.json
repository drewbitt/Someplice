{
	"name": "someplice",
	"version": "0.2.0",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:deno": "BUILD_ENV=deno vite build",
		"preview": "vite preview",
		"test:e2e": "playwright test",
		"test:unit": "vitest",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:tsgo": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo-experimental-api",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --cache --ignore-path ./config/.prettierignore --check . && eslint -c ./config/eslint.config.js .",
		"format": "prettier --cache --ignore-path ./config/.prettierignore --write .",
		"db:codegen": "kysely-codegen --out-file ./src/lib/types/data.d.ts && prettier --cache --ignore-path ./config/.prettierignore --write ./src/lib/types/data.d.ts",
		"db:migrate": "node ./src/lib/db/migrate-to-latest.ts",
		"db:migrate:single": "node ./src/lib/db/migrate-to-latest.ts --migration",
		"db:reset": "rm -f ./data/db.sqlite && pnpm run db:migrate && pnpm run db:codegen",
		"db:seed": "node ./src/lib/db/insert-fake-data.ts",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"@trpc/client": "^11.19.0",
		"@trpc/server": "^11.19.0",
		"croner": "^10.0.1",
		"devalue": "^6.0.2",
		"kysely": "^0.29.6",
		"kysely-generic-sqlite": "^2.0.1",
		"runed": "0.37.1",
		"tslog": "^5.2.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@deno/svelte-adapter": "^0.2.1",
		"@eslint/js": "^10.0.1",
		"@iconify-json/lucide": "^1.2.135",
		"@ngneat/falso": "^8.0.2",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.13.6",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vite-pwa/sveltekit": "^1.1.0",
		"better-sqlite3": "^12.11.1",
		"daisyui": "^5.7.42",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"kysely-codegen": "^0.20.0",
		"lefthook": "^2.1.14",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-dnd-action": "^0.9.79",
		"tailwindcss": "^4.3.3",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.70.1",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.0",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^5.0.1",
		"workbox-build": "^7.4.1",
		"workbox-window": "^7.4.1"
	},
	"type": "module",
	"engines": {
		"node": ">=24.21.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.21.0",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.6.0"
}
