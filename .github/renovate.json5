{
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',
	extends: [
		'config:best-practices',
		':semanticCommits',
		// Raise each PR the moment its branch is pushed (weekly window), not
		// whenever CI happens to settle.
		':prImmediately',
		// No off-schedule rebases or updates on existing PRs.
		':noUnscheduledUpdates',
		// pnpm autoDedupe dedupes the lockfile on every update.
		':maintainLockFilesDisabled',
		// Majors wait for Dependency Dashboard approval.
		':approveMajorUpdates'
	],
	rangeStrategy: 'bump',
	// Bad or yanked releases self-filter before they can be proposed.
	minimumReleaseAge: '7 days',
	timezone: 'America/New_York',
	// All update work happens inside the weekly Monday window.
	schedule: ['* * * * 1'],
	// Vulnerability fix PRs skip the schedule by default — hold them to it too.
	vulnerabilityAlerts: { schedule: ['* * * * 1'] },
	packageRules: [
		{
			// Keep SemVer ranges in package.json — undoes :pinDevDependencies
			// from config:best-practices for manifest entries only.
			matchDepTypes: ['devDependencies', 'dev-dependencies', 'dev'],
			rangeStrategy: 'bump'
		},
		{
			// All non-major updates in a single weekly PR instead of
			// separate PRs per dependency.
			matchUpdateTypes: ['minor', 'patch', 'pin', 'digest'],
			groupName: 'non-major updates',
			groupSlug: 'non-major',
			automerge: true,
			schedule: ['* 17-23 * * 1']
		}
	]
}
