{
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',
	extends: [
		'config:best-practices',
		':semanticCommits',
		':noUnscheduledUpdates',
		':approveMajorUpdates'
	],
	// Keep manifest ranges and let regular updates refresh the lockfile.
	ignorePresets: [':pinDevDependencies', ':maintainLockFilesWeekly'],
	rangeStrategy: 'bump',
	// Apply the same cooldown to versions pnpm actually resolves.
	minimumReleaseAge: '7 days',
	minimumReleaseAgePackageManagerSync: true,
	// Use Renovate-managed automerge with GitHub auto-merge disabled.
	platformAutomerge: false,
	timezone: 'America/New_York',
	// Routine updates run on Monday. Vulnerability alerts use Renovate's immediate schedule.
	schedule: ['* * * * 1'],
	vulnerabilityAlerts: { automerge: false },
	packageRules: [
		{
			// The inherited npm preset sets three days for version updates.
			matchDatasources: ['npm'],
			matchUpdateTypes: ['major', 'minor', 'patch'],
			minimumReleaseAge: '7 days'
		},
		{
			// Batch routine bumps. Toolchain changes below get dedicated reviews.
			matchUpdateTypes: ['minor', 'patch', 'pin', 'digest'],
			groupName: 'non-major updates',
			groupSlug: 'non-major',
			automerge: true,
			schedule: ['* 17-23 * * 1']
		},
		{
			// Keep the runtime, Docker images and CI package manager in sync.
			matchPackageNames: ['node', 'pnpm', 'pnpm/setup'],
			matchUpdateTypes: ['minor', 'patch', 'pin', 'digest'],
			groupName: 'Node and pnpm',
			groupSlug: 'node-pnpm',
			automerge: false
		},
		{
			// Formatter updates can require changes to the files they format.
			matchPackageNames: ['prettier', 'prettier-plugin-*'],
			matchUpdateTypes: ['minor', 'patch', 'pin', 'digest'],
			groupName: 'Prettier',
			groupSlug: 'prettier',
			automerge: false
		},
		{
			// Review the compiler and lint parser together when their peers change.
			matchPackageNames: [
				'typescript',
				'@typescript/typescript6',
				'typescript-eslint',
				'svelte-check'
			],
			matchUpdateTypes: ['minor', 'patch', 'pin', 'digest'],
			groupName: 'TypeScript tooling',
			groupSlug: 'typescript-tooling',
			automerge: false
		},
		{
			// 2.2.2 lost the trusted publishing/provenance present in 2.2.1.
			// Keep pnpm's no-downgrade policy and isolate future hook updates.
			matchPackageNames: ['lefthook'],
			allowedVersions: '!/^2\\.2\\.2$/',
			groupName: 'lefthook',
			groupSlug: 'lefthook',
			automerge: false
		}
	]
}
